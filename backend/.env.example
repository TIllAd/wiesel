# Anthropic Claude API
ANTHROPIC_API_KEY=sk-you...here
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional separate model for backend/jobs/chat_review.py; defaults to ANTHROPIC_MODEL.
ANTHROPIC_REVIEW_MODEL=

# Cost reporting is derived from backend/config.py per model and prompt tier.
# USD_PER_EUR remains configurable because it only affects the local EUR estimate.
USD_PER_EUR=1.08

# JWT Secret for session tokens
JWT_SECRET=wiesel_jwt_secret_dev

CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Database (absolute path for Docker)
DATABASE_URL=sqlite:////app/backend/wiesel.db

# FastAPI
# In "production" verweigert die App den Start, wenn Secrets fehlen oder auf
# Dev-Defaults stehen (JWT_SECRET, ANTHROPIC_API_KEY, ADMIN_API_KEY).
ENVIRONMENT=development

# ── Security / Ops (P0, Juli 2026) ──────────────────────────────────────────
# Öffentliche Website: Bild-Uploads bleiben bis zu einer formalen Freigabe aus.
IMAGE_UPLOAD_ENABLED=false

# Löschfristen in Tagen: normale Chats, als Testfall markierte Chats, LLM-Nutzungsdaten.
CHAT_RETENTION_DAYS=30
FLAGGED_CHAT_RETENTION_DAYS=90
USAGE_RETENTION_DAYS=90

# Admin-Key für /api/logs/daily, /api/reports/*, /api/usage/*, /api/analytics/*,
# /api/session/*  (Header: X-Admin-Key). Ohne Key sind diese Endpoints gesperrt (503).
# Wird weiterhin gebraucht für Zugriffe OHNE Cloudflare Access (Scripts, Tests, Fable).
ADMIN_API_KEY=

# Cloudflare Access als zweiter Auth-Weg (Team-Login statt Key):
# Team-Domain z. B. "wiso-team" (wird zu wiso-team.cloudflareaccess.com) und das
# Audience-Tag der Access-Application (Zero Trust → Access → Applications → AUD).
# Beide gesetzt → gültiger Cf-Access-Jwt-Assertion-Header zählt als Admin-Auth.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# CORS: erlaubte Origins, kommagetrennt. Wisdom ist kanonisch; die alte
# Wiesel-Domain bleibt während der Migration für bestehende Links erlaubt.
ALLOWED_ORIGINS=https://wisdom.chatbot-wiso.de,https://wiesel.chatbot-wiso.de

# Automatische Wissensdateien (Mensa, Wetter, ÖPNV, FAU Aktuell) älter als so viele
# Stunden werden nicht mehr an WiSdom gegeben.
KB_AUTO_MAX_AGE_HOURS=48

# Kosten-Kill-Switch: bei Erreichen pausieren LLM-Calls bis Mitternacht (0 = aus).
DAILY_BUDGET_EUR=15

# Rate-Limits
RATE_LIMIT_CHAT_PER_MIN_SESSION=10
RATE_LIMIT_CHAT_PER_MIN_IP=30
RATE_LIMIT_PUBLIC_SESSIONS_PER_DAY_IP=20

# LLM-Antwortlänge (Kürze kommt aus dem Prompt; das hier ist die Notbremse)
LLM_MAX_TOKENS=700

# Session-Token-Lebensdauer in Stunden
JWT_TTL_HOURS=2

# Daily deterministic chat review; mounted from the host as ~/wiesel-reports.
# Cron: docker exec -w /app/backend wiesel-backend python -m jobs.chat_review
CHAT_REVIEW_DIR=/app/reports

# Analysis & Reporting
WIESEL_API_BASE=http://localhost:8001
REPORT_EMAIL=deine@email.de
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dein@gmail.com
SMTP_PASS=dein-app-passwort
